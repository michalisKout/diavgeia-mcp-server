{
  "compilerOptions": {
    "target": "es2022",
    "outDir": "./dist",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "files": ["src/local.ts"],
  "include": [
    "src/modules/**/*.ts",
    "src/api/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/prompts/**/*.ts"
  ],
  "exclude": ["src/index.ts", "node_modules", "dist"]
}
