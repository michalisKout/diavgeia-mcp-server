
# Diavgeia MCP Server Environment Configuration

# Diavgeia API Configuration
# The base URL for the Diavgeia API (optional, defaults to official API)
DIAVGEIA_URL=https://diavgeia.gov.gr/opendata

# Development Configuration
# Set to 'development' for local development, 'production' for deployment
NODE_ENV=development

# Cloudflare Workers Configuration (for deployment)
# Your Cloudflare account ID (optional, only needed for deployment)
# CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Your Cloudflare API token (optional, only needed for deployment)
# CLOUDFLARE_API_TOKEN=your-api-token-here

# Logging Configuration
# Log level: 'debug', 'info', 'warn', 'error' (optional, defaults to 'info')
# LOG_LEVEL=info

# Rate Limiting (optional)
# Maximum requests per minute per IP (defaults to 60)
# RATE_LIMIT_RPM=60

# CORS Configuration (optional)
# Allowed origins for CORS (comma-separated, defaults to '*')
# CORS_ORIGINS=https://your-domain.com,https://localhost:3000