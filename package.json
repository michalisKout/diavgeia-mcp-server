{
  "name": "diavgeia-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for accessing Greek government transparency data from the Diavgeia platform",
  "author": "Michalis Koutridis",
  "license": "MIT",
  "homepage": "https://github.com/michalisKout/diavgeia-mcp-server",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/michalisKout/diavgeia-mcp-server.git"
  },
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "diavgeia",
    "greek-government",
    "transparency",
    "open-data"
  ],
  "mcp": {
    "configSchema": "mcp-config-schema.json"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "build:local": "tsc --project tsconfig.local.json",
    "format": "biome format --write",
    "format:check": "biome format --check",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "check": "biome check",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.11.4",
    "agents": "0.0.90",
    "axios": "1.9.0",
    "dayjs": "1.11.13",
    "fuse.js": "7.1.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "1.1.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "3.25.16"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "22.15.21",
    "@types/pdf-parse": "1.1.5",
    "esbuild": "^0.25.10",
    "lefthook": "^2.0.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "4.127.1"
  }
}
